{
  "openapi": "3.1.0",
  "info": {
    "title": "元策系统 API",
    "summary": "元策系统 OpenAPI。",
    "description": "该契约独立于普通业务 OpenAPI，面向使用系统管理页创建的 system token 的系统级集成场景，通过 Authorization: Bearer <token> 访问。当前尚未开放任何系统级业务接口。",
    "version": "1.1.0"
  },
  "servers": [
    {
      "url": "/",
      "description": "当前元策服务"
    },
    {
      "url": "https://yuance.quanxinfu.com",
      "description": "元策正式环境"
    }
  ],
  "tags": [
    {
      "name": "meta",
      "description": "system OpenAPI 元信息"
    }
  ],
  "security": [
    {
      "systemBearerAuth": []
    }
  ],
  "paths": {
    "/api/system/openapi.json": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "获取 system OpenAPI 契约",
        "security": [],
        "responses": {
          "200": {
            "description": "OpenAPI 3.1 JSON 文档"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "systemBearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "OpaqueToken",
        "description": "在系统管理页创建的独立 system token。"
      }
    }
  }
}
