{
  "name": "@yuance/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check:js": "tsc -p jsconfig.json",
    "check:source": "node ./scripts/assert-js-only.mjs",
    "capture:main-visual": "node ./scripts/capture-main-visual-baseline.mjs --capture",
    "capture:main-visual:plan": "node ./scripts/capture-main-visual-baseline.mjs --print-plan",
    "lint": "eslint \"src/**/*.{js,jsx}\" \"test/**/*.mjs\" \"scripts/**/*.mjs\" vite.config.js eslint.config.js",
    "test": "node --test test/**/*.test.mjs",
    "check": "npm run check:source && npm run check:js && npm run lint && npm run test",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@yuance/frontend-app-shell": "file:../frontend/packages/app-shell",
    "@yuance/frontend-api-client": "file:../frontend/packages/api-client",
    "@yuance/frontend-app-core": "file:../frontend/packages/app-core",
    "@yuance/frontend-platform-contract": "file:../frontend/packages/platform-contract",
    "@yuance/frontend-ui": "file:../frontend/packages/ui",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@playwright/test": "^1.62.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.33.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.3.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true
  }
}
