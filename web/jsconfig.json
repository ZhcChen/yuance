{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noImplicitAny": false,
    "types": ["node", "react", "react-dom"]
  },
  "include": [
    "src/**/*.js",
    "src/**/*.jsx",
    "test/**/*.mjs",
    "scripts/**/*.mjs",
    "vite.config.js",
    "eslint.config.js"
  ],
  "exclude": ["dist", "node_modules"]
}
