{
  "name": "@yuance/frontend-app-shell",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./application.css": "./src/application.css"
  },
  "dependencies": {
    "@yuance/frontend-api-client": "0.1.0",
    "@yuance/frontend-app-core": "0.1.0",
    "@yuance/frontend-platform-contract": "0.1.0",
    "@yuance/frontend-ui": "0.1.0"
  },
  "peerDependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "scripts": {
    "check:source": "node ../../scripts/assert-js-only.mjs src test",
    "check:js": "tsc -p jsconfig.json --incremental --tsBuildInfoFile ../../node_modules/.cache/tsconfig.app-shell.tsbuildinfo",
    "lint": "eslint --cache --cache-location ../../node_modules/.cache/.eslintcache \"src/**/*.{js,jsx}\" \"test/**/*.mjs\"",
    "test": "tsx --test test/**/*.test.mjs",
    "check": "npm run check:source && npm run check:js && npm run lint && npm run test"
  },
  "devDependencies": {
    "tsx": "^4.23.1"
  }
}
