  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.js"
  },
  "peerDependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "scripts": {
    "check:source": "node ../../scripts/assert-js-only.mjs src test",
    "check:js": "tsc -p jsconfig.json",
