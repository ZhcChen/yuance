{
  "name": "@yuance/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check:source": "node ./scripts/assert-js-only.mjs packages scripts test",
    "check:boundaries": "node ./scripts/assert-package-boundaries.mjs",
    "check:packages": "npm run check --workspaces --if-present",
    "generate:experience-inventory": "node ./scripts/extract-legacy-experience.mjs",
    "generate:interaction-classification": "node ./scripts/classify-legacy-markers.mjs",
    "lint": "eslint \"scripts/**/*.mjs\" \"test/**/*.mjs\" eslint.config.js",
    "test": "node --test test/**/*.test.mjs",
    "check": "npm run check:source && npm run check:boundaries && npm run check:packages && npm run lint && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.33.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.3.0",
    "typescript": "^5.9.2"
  }
}
